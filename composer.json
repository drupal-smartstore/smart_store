{
    "name": "smartstore/smart_store",
    "description": "Drupal Commerce related projects maintained by smart store.",
    "type": "drupal-profile",
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/drupal-smartstore",
    "authors": [
        {
            "name": "Smart Store"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "dompdf/dompdf": "^3.1",
        "drupal/admin_toolbar": "^3.6",
        "drupal/backup_migrate": "^5.1",
        "drupal/better_exposed_filters": "^7.1",
        "drupal/block_class": "^4.0",
        "drupal/change_user_route": "^3.0",
        "drupal/color_field": "^3.0",
        "drupal/commerce": "^3.2",
        "drupal/commerce_ajax_atc": "^1.0@RC",
        "drupal/commerce_autosku": "^2.1",
        "drupal/commerce_combine_carts": "^1.1",
        "drupal/commerce_shipping": "^2.15",
        "drupal/commerce_stock": "^3.0",
        "drupal/commerce_wishlist": "^3.0@beta",
        "drupal/core_views_facets": "^2.1",
        "drupal/default_content": "^2.0@alpha",
        "drupal/dropzonejs": "^2.11",
        "drupal/easy_breadcrumb": "^2.0",
        "drupal/entity_browser": "^2.15",
        "drupal/facets": "^3.0",
        "drupal/facets_pretty_paths": "^2.0",
        "drupal/field_group": "^4.0",
        "drupal/fivestar": "^1.0@alpha",
        "drupal/flag": "^5.0",
        "drupal/imagezoom": "^2.0@beta",
        "drupal/insert_view_adv": "^2.0@alpha",
        "drupal/kart": "^1.0",
        "drupal/login_redirect_per_role": "^1.11",
        "drupal/menu_per_role": "^1.8",
        "drupal/password_policy": "^4.0",
        "drupal/phone_international": "^4.0",
        "drupal/search_api": "^1.40",
        "drupal/simplenews": "^4.1",
        "drupal/smtp": "^1.4",
        "drupal/toolbar_visibility": "^3.0",
        "drupal/twig_tweak": "^3.4",
        "drupal/upgrade_status": "^4.3",
        "enyo/dropzone": "^6.0@beta",
        "npm-asset/intl-tel-input": "^17.0",
        "oomphinc/composer-installers-extender": "^2.0",
        "smartstore/smart_store_admin": "1.x-dev",
        "smartstore/vitoria": "1.0.x-dev"


    },
    "extra": {
        "patches": {
            "drupal/change_user_route": {
                "D11 compatibility fixes": "patches/change_user_route_d11_upgrade.patch"
            },
            "drupal/commerce_autosku": {
                "D11 compatibility fix": "https://www.drupal.org/files/issues/2024-03-16/commerce_autosku.8.x-2.1.rector.patch",
                "Compatibility warnings fix": "patches/commerce_autosku_d11_warnings_fixes.patch"
            },
            "drupal/fivestar": {
                "D11 compatibility fix": "https://www.drupal.org/files/issues/2024-06-02/fivestar.1.x-dev.rector_0.patch",
                "Compatibility warnings fix": "patches/fivestar_d11_warnings_fixes.patch"
            },
            "drupal/imagezoom": {
                "D11 compatibility fix": "https://www.drupal.org/files/issues/2024-07-06/imagezoom.2.x-dev.rector.patch",
                "Drupal 11: fix unsafe new static() in ImageZoomFormatter": "patches/imagezoom_d11_new_static.patch"
            },
            "drupal/kart": {
                "Twig 3.12: remove deprecated spaceless filter": "patches/kart_twig_spaceless_deprecation.patch"
            },
            "drupal/toolbar_visibility": {
                "Drupal 11: fix unsafe new static() in ToolbarVisibilitySettingsForm": "patches/toolbar_visibility_d11_new_static.patch"
            },
            "drupal/votingapi": {
                "D11 compatibility fix": "https://www.drupal.org/files/issues/2025-04-02/d11-votingapi.patch",
                "D11 warnings fixes (new static, PHP 8.4 nullable, missing returns)": "patches/votingapi_d11_warnings_fixes.patch"
            }
        }
    }
}
