+  // Check to see if there is a fivestar field on this entity type.
+  $entity_field_manager = \Drupal::service('entity_field.manager');
+  $field_map = $entity_field_manager->getFieldMap();
+  if (!isset($field_map[$entity_type])) {
+    return FALSE;
+  }
+  foreach ($field_map[$entity_type] as $field_name => $field_info) {
+    $storage_definitions = $entity_field_manager->getFieldStorageDefinitions($entity_type);
+    if (!isset($storage_definitions[$field_name])) {
