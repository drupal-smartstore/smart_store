<div id="sales-chart-container">
	<div class="icon-sales-wrapper">
		<div class="icon">
			<img src="/sites/default/files/inline-images/sales.png" alt="Sales">
		</div>

		<div class="info">
			<div class="total-sales">
				<h4>
					Total Sales
					<span>{{ content.total_sales }}</span>
				</h4>
			</div>

			<div class="percentage-change">{{ content.percentage_change }}</div>
		</div>
	</div>

	<div id="sales-chart"></div>
</div>
