{% if data %}
	{% if data.order_id %}
		<a href="{{ path('ss_invoice.download_invoice', {'order_id': data.order_id}) }}" class="button--primary button">
			{{ 'Download Invoice' | t }}
		</a>

		<button type="button" class="btn btn-primary print-button">
			{{ 'Print Invoice' | t }}
		</button>
	{% endif %}

	{{ include('invoice-template.html.twig', { data: data }) }}
{% else %}
	<div style="display: flex; justify-content: center; margin: 25px 0;">
		<h2>No Data Found</h2>
	</div>
{% endif %}
