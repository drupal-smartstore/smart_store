<?php

/**
 * @file
 * Install file for Commerce AI Intelligence module.
 */

/**
 * Implements hook_schema().
 */
function commerce_ai_intelligence_schema() {
  $schema = [];

  $schema['commerce_ai_intelligence_insight_details'] = [
    'description' => 'Stores market insight requests.',
    'fields' => [
      'id' => ['type' => 'serial', 'not null' => TRUE],
      'store_id' => ['type' => 'int'],
      'product_type' => ['type' => 'varchar', 'length' => 50, 'not null' => TRUE],
      'lookback_days' => ['type' => 'int'],
      'from_date' => ['type' => 'varchar', 'length' => 20],
      'to_date' => ['type' => 'varchar', 'length' => 20],
      'limit' => ['type' => 'int'],
      'created' => ['type' => 'int', 'not null' => TRUE],
      'status' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'default' => 'in_progress',
      ],
      'insights' => ['type' => 'text', 'size' => 'big'],
      'error_message' => ['type' => 'text', 'size' => 'big'],
      'completed' => ['type' => 'int'],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'store_id' => ['store_id'],
      'status' => ['status'],
      'created' => ['created'],
    ],
  ];

  $schema['commerce_ai_intelligence_insight_products'] = [
    'description' => 'Stores product-level strategic market insights.',
    'fields' => [
      'id' => ['type' => 'serial', 'not null' => TRUE],
      'insight_request_id' => ['type' => 'int', 'not null' => TRUE],
      'product_id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'product_name' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE],
      'category' => ['type' => 'varchar', 'length' => 100, 'not null' => TRUE],
      'category_reasoning' => ['type' => 'text', 'size' => 'big'],

      'demand_momentum' => ['type' => 'text', 'size' => 'big'],
      'trend_dynamics' => ['type' => 'text', 'size' => 'big'],
      'competition_landscape' => ['type' => 'text', 'size' => 'big'],
      'opportunity' => ['type' => 'text', 'size' => 'big'],
      'sustainability' => ['type' => 'text', 'size' => 'big'],
      'seasonality' => ['type' => 'text', 'size' => 'big'],
      'customer_segments' => ['type' => 'text', 'size' => 'big'],

      'strategic_insight' => ['type' => 'text', 'size' => 'big'],
      'decision_framing' => ['type' => 'text', 'size' => 'big'],
      'review_cadence' => ['type' => 'text', 'size' => 'big'],

      'confidence_overall' => ['type' => 'varchar', 'length' => 20],
      'metadata' => ['type' => 'text', 'size' => 'big'],

      'created' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
      'updated' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'insight_request_id' => ['insight_request_id'],
      'product_id' => ['product_id'],
      'category' => ['category'],
      'confidence_overall' => ['confidence_overall'],
    ],
  ];

  $schema['commerce_ai_intelligence_forecast_details'] = [
    'description' => 'Stores forecast requests.',
    'fields' => [
      'id' => ['type' => 'serial', 'not null' => TRUE],
      'store_id' => ['type' => 'int'],
      'product_type' => ['type' => 'varchar', 'length' => 50, 'not null' => TRUE],
      'limit' => ['type' => 'int'],
      'market_insight_id' => ['type' => 'int', 'description' => 'Reference to related market insight.'],
      'created' => ['type' => 'int', 'not null' => TRUE],
      'status' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'default' => 'in_progress',
      ],
      'summary' => ['type' => 'text', 'size' => 'big'],
      'error_message' => ['type' => 'text', 'size' => 'big'],
      'completed' => ['type' => 'int'],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'store_id' => ['store_id'],
      'status' => ['status'],
      'created' => ['created'],
    ],
  ];

  $schema['commerce_ai_intelligence_forecast_products'] = [
    'description' => 'Stores product-level forecast insights generated by AI.',
    'fields' => [
      'id' => ['type' => 'serial', 'not null' => TRUE],
      'forecast_request_id' => ['type' => 'int', 'not null' => TRUE, 'description' => 'Reference to forecast request.'],
      'product_id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'product_name' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE],
      'category' => ['type' => 'varchar', 'length' => 100, 'not null' => TRUE],
      'opportunity_score' => ['type' => 'text', 'size' => 'big', 'description' => 'JSON: opportunity score breakdown'],
      'demand_forecast' => ['type' => 'text', 'size' => 'big', 'description' => 'JSON: demand projections'],
      'price_forecast' => ['type' => 'text', 'size' => 'big', 'description' => 'JSON: pricing strategy'],
      'profit_cost' => ['type' => 'text', 'size' => 'big', 'description' => 'JSON: margin and cost structure'],
      'benchmarks' => ['type' => 'text', 'size' => 'big', 'description' => 'JSON: comparative benchmarks'],
      'operational_forecast' => ['type' => 'text', 'size' => 'big', 'description' => 'JSON: inventory and logistics'],
      'seasonality' => ['type' => 'text', 'size' => 'big', 'description' => 'JSON: seasonal trends'],
      'decision_framing' => ['type' => 'text', 'size' => 'big', 'description' => 'JSON: recommended actions'],
      'review_cadence' => ['type' => 'text', 'size' => 'big', 'description' => 'JSON: review strategy'],
      'historical_performance' => ['type' => 'text', 'size' => 'big', 'description' => 'JSON: past performance data'],
      'competition_metrics' => ['type' => 'text', 'size' => 'big', 'description' => 'JSON: competitor insights'],
      'confidence_score' => ['type' => 'text', 'size' => 'big', 'description' => 'JSON: overall confidence and factors'],
      'metadata' => ['type' => 'text', 'size' => 'big', 'description' => 'JSON: model metadata'],
      'created' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
      'updated' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
    ],

    'primary key' => ['id'],
    'indexes' => [
      'forecast_request_id' => ['forecast_request_id'],
      'product_id' => ['product_id'],
      'category' => ['category'],
      'forecast_confidence' => ['forecast_request_id', 'confidence_score'],
      'forecast_category' => ['forecast_request_id', 'category'],
    ],
  ];

  return $schema;
}

/**
 * Implements hook_uninstall().
 */
function commerce_ai_intelligence_uninstall() {
  $connection = \Drupal::database();

  $connection->schema()->dropTable('commerce_ai_intelligence_insight_details');
  $connection->schema()->dropTable('commerce_ai_intelligence_insight_products');
  $connection->schema()->dropTable('commerce_ai_intelligence_forecast_details');
  $connection->schema()->dropTable('commerce_ai_intelligence_forecast_products');
}
