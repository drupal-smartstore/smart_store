{% set insight = data.insight %}

<div class="theme-insight">
	{% set insight = data.insight %}
	<div class="insight-container">
		<h2>Market Insight</h2>
		<p class="summary-text">
			{{ insight.summary|raw }}
		</p>
		<button id="openModalBtn" class="btn-primary">More detailed information</button>
	</div>

	<!-- Make sure the modal is inside or has the class too -->
	<div id="detailsModal" class="modal">
		<div class="modal-content">

			<span class="close-btn">&times;</span>
			<h2 class="modal-title">Detailed Market Insights</h2>

			<div class="data-section">
				<h3>Demand Patterns</h3>
				<div class="pattern-grid">
					{% for item in insight.demand_patterns %}
						<div class="pattern-card">
							<span class="trend-badge">{{ item.trend }}</span>
							<h4>{{ item.pattern }}</h4>
							<p>{{ item.insight }}</p>
						</div>
					{% endfor %}
				</div>
			</div>

			<div class="data-section">
				<h3>Trending Categories</h3>
				<ul>
					{% for item in insight.trending_categories %}
						<li>{{ item }}</li>
					{% endfor %}
				</ul>
			</div>

			<div class="data-section">
				<h3>Seasonal & Festival Opportunities</h3>
				<div class="split-list">
					<div>
						<h4>Seasonal</h4>
						<ul>
							{% for item in insight.seasonal_opportunities %}
								<li>{{ item }}</li>
							{% endfor %}
						</ul>
					</div>
					<div>
						<h4>Festivals</h4>
						<ul>
							{% for item in insight.festival_opportunities %}
								<li>{{ item }}</li>
							{% endfor %}
						</ul>
					</div>
				</div>
			</div>

			<div class="data-section">
				<h3>Customer Behavior</h3>
				<ul>
					{% for item in insight.customer_behavior %}
						<li>{{ item }}</li>
					{% endfor %}
				</ul>
			</div>

			<div class="data-section">
				<h3>Strategic Themes</h3>
				<ul>
					{% for item in insight.strategic_themes %}
						<li>{{ item }}</li>
					{% endfor %}
				</ul>
			</div>
		</div>
	</div>
</div>
